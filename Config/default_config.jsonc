// TaskbarEngine Default Configuration
// Edit this file to customize your taskbar.
// Changes are detected automatically — no restart required.

{
    // Core engine settings
    "core": {
        "log_level": "info",      // debug, info, warning, error
        "log_max_files": 5,
        "log_max_size_mb": 5
    },

    // Plugin configurations
    "plugins": {
        // Taskbar resize plugin — adjusts taskbar height and spacing
        "taskbar_resize": {
            "enabled": true,
            "height": 32,            // Calibrated heights: 32 (recommended sweet spot), 36 (relaxed), 30 (compact), 24 (ultra)
            "padding_top": 0,        // Fine-tune vertical offset in logical pixels (-20 to 20)
            "padding_bottom": 0,     // Fine-tune vertical offset in logical pixels (-20 to 20)
            "icon_spacing": 4        // Horizontal spacing between icons (0 to 32)
        },

        // Icon hover plugin — macOS Dock-style magnification
        "icon_hover": {
            "enabled": true,
            "max_scale": 1.2,
            "radius": 150,
            "curve": "gaussian",     // gaussian, cubic, cosine, linear
            "speed_ms": 150
        }
    }
}
