{
    "version": 1,

    // Core engine settings
    "core": {
        "log_level": "info",
        "log_to_file": true
    },

    // Plugin configurations
    "plugin": {
        "taskbar_resize": {
            "enabled": false,
            "height": 48,
            "padding": 4,
            "margins": 0,
            "icon_spacing": 8
        },
        "icon_hover": {
            "enabled": true,
            "scale": 1.35,
            "radius": 130,
            "curve": "gaussian",
            "speed_ms": 150
        }
    }
}
