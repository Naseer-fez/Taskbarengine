{
	"core":	{
		"log_level":	"info",
		"log_max_files":	5,
		"log_max_size_mb":	5
	},
	"plugins":	{
		"taskbar_resize":	{
			"enabled":	false,
			"height":	48,
			"padding_top":	0,
			"padding_bottom":	0,
			"icon_spacing":	0
		},
		"icon_hover":	{
			"enabled":	true,
			"max_scale":	3.15,
			"radius":	150,
			"curve":	"cubic",
			"speed_ms":	500,
			"bounce_enabled":	true,
			"bounce_strength":	800,
			"tilt_enabled":	true,
			"max_tilt_angle":	20,
			"drag_drop_enabled":	true,
			"drag_recession_scale":	0.8,
			"drop_zone_push":	120,
			"keep_on_top":	true,
			"start_image_path":	"",
			"dynamic_island":	{
				"enabled":	false,
				"padding_tray":	6,
				"compact_width":	80,
				"expanded_width":	240,
				"height":	30,
				"show_idle_pill":	false
			}
		}
	}
}