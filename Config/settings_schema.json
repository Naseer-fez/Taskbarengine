{
  "plugins": [
    {
      "name": "taskbar_resize",
      "version": "0.3.0",
      "description": "Resizes the Windows taskbar and restores it on disable.",
      "settings": [
        { "key": "height", "label": "Height", "tooltip": "Taskbar height in logical pixels.", "type": "int", "default": 36, "min": 20, "max": 80, "step": 1 },
        { "key": "padding", "label": "Padding", "tooltip": "Reserved padding around taskbar content.", "type": "int", "default": 4, "min": 0, "max": 20, "step": 1 },
        { "key": "margins", "label": "Margins", "tooltip": "Reserved taskbar edge margin.", "type": "int", "default": 0, "min": 0, "max": 20, "step": 1 },
        { "key": "icon_spacing", "label": "Icon spacing", "tooltip": "Reserved spacing between taskbar icons.", "type": "int", "default": 8, "min": 0, "max": 32, "step": 1 }
      ]
    },
    {
      "name": "icon_hover",
      "version": "0.4.0",
      "description": "Magnifies taskbar icons on hover using DirectComposition and smooth animation curves.",
      "settings": [
        { "key": "scale", "label": "Scale", "tooltip": "Maximum icon scale.", "type": "float", "default": 1.3, "min": 1.0, "max": 2.0, "step": 0.1 },
        { "key": "radius", "label": "Radius", "tooltip": "Magnification radius in px.", "type": "int", "default": 120, "min": 40, "max": 300, "step": 10 },
        { "key": "curve", "label": "Curve", "tooltip": "Magnification falloff curve.", "type": "enum", "default": "gaussian", "options": ["gaussian", "cubic", "linear", "cosine"] },
        { "key": "speed_ms", "label": "Speed", "tooltip": "Settle animation speed in ms.", "type": "int", "default": 150, "min": 50, "max": 500, "step": 10 }
      ]
    }
  ]
}
