{
  "manifest_version": 1,
  "api_version": 2,
  "id": "media",
  "name": "Media",
  "description": "Shows the current media session and provides playback controls.",
  "module": "media.dll",
  "settings": [
    { "key": "show_artist", "label": "Show artist", "type": "bool", "default": true },
    { "key": "max_width", "label": "Maximum width", "type": "int", "default": 200, "min": 120, "max": 400, "step": 10 },
    { "key": "font_size", "label": "Text size", "type": "float", "default": 12, "min": 8, "max": 32, "step": 0.5 },
    { "key": "font_family", "label": "Font family", "type": "string", "default": "Segoe UI Variable" },
    { "key": "text_color", "label": "Text color", "type": "color", "default": 4294967295 }
  ]
}
